<?xml version="1.0"?>
<configuration>
  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None"/>
  </appSettings>
  <connectionStrings>
    <!-- Agar SQL Server Express use kar rahi ho to Data Source=.\SQLEXPRESS likhna -->
    <add name="LibraNestDB"
         connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=LibraNestDB;Integrated Security=True;Connect Timeout=90"
         providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8"/>
    <httpRuntime targetFramework="4.8"/>
    <sessionState timeout="30"/>
  </system.web>
</configuration>
