<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.master.cs" Inherits="SiteMaster" %>
<!DOCTYPE html>
<html>
<head runat="server">
    <title>LibraNest - Library Management System</title>
    <link href="~/style.css" rel="stylesheet" />
</head>
<body>
<form id="form1" runat="server">
